METERBILL_VERSION=2026.10.14
METERBILL_APP_IMAGE=meterbill-app
METERBILL_GATEWAY_IMAGE=meterbill-gateway
METERBILL_HTTP_PORT=18080
PROMETHEUS_HOST_PORT=19091

MYSQL_DATABASE=meterbill
MYSQL_USER=meterbill
MYSQL_PASSWORD=replace_with_app_password
MYSQL_ROOT_PASSWORD=replace_with_root_password
RABBITMQ_USER=meterbill
RABBITMQ_PASSWORD=replace_with_strong_password
REDIS_PASSWORD=replace_with_strong_password
METERBILL_JWT_SECRET_BASE64=replace_with_at_least_32_random_bytes_in_base64
METERBILL_PROMETHEUS_TOKEN=replace_with_short_lived_bearer_token
SPRING_PROFILES_ACTIVE=

# Enable only for first-time isolated acceptance or controlled bootstrap.
METERBILL_BOOTSTRAP_ENABLED=false
METERBILL_BOOTSTRAP_TENANT_CODE=
METERBILL_BOOTSTRAP_EMAIL=
METERBILL_BOOTSTRAP_PASSWORD=
