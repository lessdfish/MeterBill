MYSQL_HOST=127.0.0.1
MYSQL_HOST_PORT=13306
MYSQL_DATABASE=meterbill
MYSQL_USER=meterbill

MYSQL_ROOT_PASSWORD=replace_with_root_password
MYSQL_PASSWORD=replace_with_app_password

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=meterbill
RABBITMQ_PASSWORD=replace_with_strong_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_HOST_PORT=16379
REDIS_PASSWORD=replace_with_strong_password

#Security
METERBILL_JWT_SECRET_BASE64=replace_with_base64_key

# Local bootstrap only
METERBILL_BOOTSTRAP_ENABLED=false
METERBILL_BOOTSTRAP_EMAIL=admin@example.com
METERBILL_BOOTSTRAP_PASSWORD=replace_with_strong_password
METERBILL_BOOTSTRAP_TENANT_CODE=acme
